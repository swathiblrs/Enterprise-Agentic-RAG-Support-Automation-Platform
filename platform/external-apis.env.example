# Load these into the server process environment. Do not commit real secrets.
# The default local case workflow never calls providers.
EXTERNAL_APIS_ENABLED=false
INTEGRATION_ADMIN_KEY=

# Jira Cloud: a project you are authorized to use.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE_ID=

# Delegated tokens for your own authorized test accounts.
# Graph: User.Read. Google Drive: drive.readonly or an appropriate narrower scope.
MICROSOFT_GRAPH_ACCESS_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Separate names keep the offline workflow's settings from overriding this opt-in client.
EXTERNAL_OPENAI_API_KEY=
EXTERNAL_OPENAI_MODEL=

# Slack bot scope chat:write; bot must have access to the configured channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
